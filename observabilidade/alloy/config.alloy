discovery.docker "containers" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "5s"

  filter {
    name   = "label"
    values = ["com.eventosexpress.logs=true"]
  }
}

discovery.relabel "logs" {
  targets = []

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service_name"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "project"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

loki.source.docker "logs" {
  host             = "unix:///var/run/docker.sock"
  targets          = discovery.docker.containers.targets
  labels           = { app = "eventos-express" }
  relabel_rules    = discovery.relabel.logs.rules
  refresh_interval = "5s"
  forward_to       = [loki.process.logs.receiver]
}

loki.process "logs" {
  stage.decolorize {}

  stage.match {
    selector = "{service_name=~\"eventos-service|inscricoes-service\"}"

    stage.multiline {
      firstline     = "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"
      max_wait_time = "3s"
      max_lines     = 256
    }

    stage.regex {
      expression = "^[0-9]{4}-[0-9]{2}-[0-9]{2}T\\S+\\s+(?P<level>TRACE|DEBUG|INFO|WARN|ERROR)"
    }

    stage.labels {
      values = {
        level = "",
      }
    }
  }

  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}